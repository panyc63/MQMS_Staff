<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login_Page2">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_login_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="150dp">
        <ImageView
            android:id="@+id/login_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/customer_icon" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/tv_Welc_Login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#000000"
        android:text="Welcome"
        app:layout_constraintTop_toBottomOf="@+id/cardview_login_img"
        app:layout_constraintStart_toStartOf="@+id/cardview_login_img" />
    <TextView
        android:id="@+id/tv_Enter_Password_below"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        android:text="Please enter your password below"
        app:layout_constraintTop_toBottomOf="@+id/tv_Welc_Login"
        app:layout_constraintStart_toStartOf="@+id/tv_Welc_Login"
        app:layout_constraintStart_toEndOf="@+id/tv_Welc_Login" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintTop_toBottomOf="@id/tv_Enter_Password_below"
        app:layout_constraintStart_toStartOf="@+id/tv_Enter_Password_below"
        app:layout_constraintEnd_toEndOf="@+id/tv_Enter_Password_below"
        android:hint="Password">

        <EditText
            android:id="@+id/et_Password_Login"
            android:inputType="textPassword"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        app:layout_constraintTop_toBottomOf="@id/password_layout"
        app:layout_constraintStart_toStartOf="@+id/password_layout"
        app:layout_constraintEnd_toEndOf="@+id/password_layout"
        app:cardCornerRadius="15dp">
    <Button
        android:id="@+id/btn_login2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/Red"

        android:text="Login"/>

    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/forget_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        android:text="Forget Password"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/cardview_btn_login" />
</androidx.constraintlayout.widget.ConstraintLayout>