<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CustomerReport">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="25dp"
        android:layout_margin="50dp" >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp">

            <TextView
                android:id="@+id/customer_report_custName_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                android:textSize="15sp"
                android:text="Customer Name:"

                />
            <TextView
                android:id="@+id/customer_report_tvCustName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="@id/customer_report_custName_label"
                app:layout_constraintStart_toEndOf="@id/customer_report_custName_label"
                android:textSize="15sp"
                android:text="hello"/>

            <TextView
                android:id="@+id/customer_report_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/customer_report_tvCustName"
                app:layout_constraintEnd_toEndOf="@id/customer_report_custName_label"
                android:textSize="15sp"
                android:text="Date:"

                />
            <TextView
                android:id="@+id/customer_report_tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="@id/customer_report_date_label"
                app:layout_constraintStart_toEndOf="@id/customer_report_date_label"
                android:textSize="15sp"
                android:text="hello"/>


            <TextView
                android:id="@+id/customer_report_transac_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/customer_report_date_label"
                app:layout_constraintEnd_toEndOf="@id/customer_report_date_label"
                android:textSize="15sp"
                android:text="Transaction Type:"

                />
            <TextView
                android:id="@+id/customer_report_tvTransactionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@id/customer_report_tvDate"
                app:layout_constraintStart_toEndOf="@id/customer_report_custName_label"
                android:textSize="15sp"
                android:text="hello"/>

            <TextView
                android:id="@+id/customer_report_startTime_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/customer_report_transac_type_label"
                app:layout_constraintEnd_toEndOf="@id/customer_report_transac_type_label"
                android:textSize="15sp"
                android:text="Start Time:"


                />
            <TextView
                android:id="@+id/customer_report_tvstartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@id/customer_report_tvTransactionType"
                app:layout_constraintStart_toEndOf="@id/customer_report_transac_type_label"
                android:textSize="15sp"
                android:text="hello"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_layout_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:layout_constraintTop_toBottomOf="@id/cardViewCustomer"
        android:hint="Feedback"
        >
        <EditText
            android:id="@+id/input_et_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_layout_feedback"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="30dp"
        >
        <Button
            android:id="@+id/customer_report_btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:background="@color/SkyBlue"

            />
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>