<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".user_profile">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_userProfile_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="150dp">
        <ImageView
            android:id="@+id/user_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/customer_icon" />
    </androidx.cardview.widget.CardView>
    <Button
        android:id="@+id/user_profile_btnChangeProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="25dp"
        android:paddingHorizontal="30dp"
        android:text="Change Profile Picture"
        app:layout_constraintStart_toEndOf="@id/cardview_userProfile_img"
        app:layout_constraintTop_toTopOf="@id/cardview_userProfile_img" />

    <TextView
        android:id="@+id/user_profile_show_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/cardview_userProfile_img"
        android:text="Name: "
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/cardview_userProfile_img"/>

    <TextView
        android:id="@+id/user_profile_tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/user_profile_show_name"
        android:text="test123"
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/cardview_userProfile_img"/>


    <TextView
        android:id="@+id/user_profile_show_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/cardview_userProfile_img"
        android:text="Email: "
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_show_name"/>

    <TextView
        android:id="@+id/user_profile_tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/user_profile_show_email"
        android:text="test123"
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_tvName"/>

    <TextView
        android:id="@+id/user_profile_show_dept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/cardview_userProfile_img"
        android:text="Department: "
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_show_email"/>

    <TextView
        android:id="@+id/user_profile_tvDept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/user_profile_show_dept"
        android:text="General Enquiries"
        android:layout_marginTop="15dp"
        android:textSize="25sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_tvEmail"/>

    <TextView
        android:id="@+id/user_profile_show_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/cardview_userProfile_img"
        android:text="Counter: "
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_show_dept"/>

    <TextView
        android:id="@+id/user_profile_tvCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/user_profile_show_counter"
        android:text="test123"
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/user_profile_tvDept"/>


</androidx.constraintlayout.widget.ConstraintLayout>